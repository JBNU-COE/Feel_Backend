# Database Configuration
DB_USERNAME=feel
DB_PASSWORD=your_secure_password_here

# Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=prod

# Domain Configuration (HTTPS 설정 시 필요)
DOMAIN_NAME=your-domain.com
EMAIL=your-email@example.com

# JWT (앱 로그인 토큰 서명 키 — 32자 이상 랜덤 문자열로 교체)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JWT_EXPIRATION=86400000

# Admin seed (선택). 미설정 시 관리자 계정 자동 생성 안 함
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_admin_password

# Google OAuth 2.0 Web Client ID
# Google Cloud Console > APIs & Services > Credentials 에서 발급
# 프론트엔드 GIS / @react-oauth/google 에 넣는 Client ID 와 동일해야 함
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
